#!/bin/sh
# Strip AI attribution trailers from every commit message.
#
# docs/CLAUDE.md section 11 forbids them. The tooling that adds them is not reliably
# controlled by settings, because the instruction arrives inside a tool prompt at
# generation time rather than from configuration. A hook is the only place the rule
# can be enforced rather than requested, so this is the enforcement and the settings
# entries are the request.
#
# Enabled by core.hooksPath. See README and docs/CLAUDE.md section 11.
set -eu

msg="$1"
tmp="$msg.attribution"

grep -viE '^Co-Authored-By: Claude|Generated with \[Claude Code\]|^Claude-Session:' "$msg" > "$tmp" || true

# Drop the blank lines a stripped trailer leaves behind at the end of the message.
awk '
  { line[NR] = $0 }
  END {
    last = NR
    while (last > 0 && line[last] ~ /^[[:space:]]*$/) { last-- }
    for (i = 1; i <= last; i++) { print line[i] }
  }
' "$tmp" > "$msg"

rm -f "$tmp"
