<html>
<head>
<title>Member Detail</title>
<style>
body { font-family: Tahoma, Verdana, sans-serif; font-size: 11px; background: #ece9d8; margin: 8px; }
h1 { font-size: 14px; margin: 0 0 8px 0; }
td.lbl { text-align: right; padding-right: 6px; white-space: pre; }
table.grid { border-collapse: collapse; margin-top: 10px; }
table.grid td { border: 1px solid #808080; padding: 2px 6px; }
tr.hdr td { background: #d4d0c8; font-weight: bold; }
td.amt { text-align: right; font-family: "Courier New", monospace; }
</style>
</head>
<body>
<h1>Member Detail</h1>
<table border="0" cellpadding="3" cellspacing="0">
  <tr><td class="lbl">Member No:</td><td><%= member.id %></td></tr>
  <tr><td class="lbl">Name:</td><td><%= member.name %></td></tr>
<% if (member.card !== undefined) { %>
  <tr><td class="lbl">Card:</td><td><%= member.card %></td></tr>
<% } %>
</table>
<table class="grid" border="1" cellpadding="3" cellspacing="0">
  <tr class="hdr"><td>Suffix</td><td>Account</td><td>Balance</td></tr>
<% for (const account of member.accounts) { %>
  <tr><td><%= account.suffix %></td><td><%= account.type %></td><td class="amt"><%= account.balance %></td></tr>
<% } %>
</table>
</body>
</html>
