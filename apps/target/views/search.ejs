<html>
<head>
<title>Member Search</title>
<style>
body { font-family: Tahoma, Verdana, sans-serif; font-size: 11px; background: #ece9d8; margin: 8px; }
h1 { font-size: 14px; margin: 0 0 8px 0; }
td.lbl { text-align: right; padding-right: 6px; white-space: pre; }
td.btn { background: #d4d0c8; border: 2px outset #ffffff; padding: 2px 12px; cursor: pointer; }
td.msg { color: #800000; font-weight: bold; padding-top: 10px; }
table.grid { border-collapse: collapse; margin-top: 10px; }
table.grid td { border: 1px solid #808080; padding: 2px 6px; }
tr.hdr td { background: #d4d0c8; font-weight: bold; }
</style>
</head>
<body>
<h1>Member Search</h1>
<form id="srch" name="ctl00" method="post" action="/servicing/search">
<table border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td>
      <table border="0" cellpadding="3" cellspacing="0">
        <tr>
          <td class="lbl">Member  ID:</td>
          <td><input type="text" id="<%= fields.memberId.id %>" name="<%= fields.memberId.name %>" size="12" maxlength="10" value="<%= values.memberId %>"></td>
        </tr>
        <tr>
          <td class="lbl">Surname:</td>
          <td><input type="text" id="<%= fields.surname.id %>" name="<%= fields.surname.name %>" size="20" maxlength="40" value="<%= values.surname %>"></td>
        </tr>
        <tr>
          <td></td>
          <td>
            <table border="0" cellpadding="0" cellspacing="0">
              <tr><td class="btn" onclick="document.forms['ctl00'].submit()">Search</td></tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</form>
<% if (message !== null) { %>
<table border="0" cellpadding="0" cellspacing="0">
  <tr><td class="msg"><%= message %></td></tr>
</table>
<% } %>
<% if (dialog) { %>
<div role="dialog" aria-label="Session notice" style="position:fixed; left:300px; top:200px; width:380px; background:#ece9d8; border:2px outset #ffffff; padding:12px;">
  <p>Your session will expire soon. Contact the service desk.</p>
  <table border="0" cellpadding="0" cellspacing="0">
    <tr><td class="btn" onclick="this.closest('[role=dialog]').remove()">OK</td></tr>
  </table>
</div>
<% } %>
<% if (results.length > 0) { %>
<table class="grid" border="1" cellpadding="3" cellspacing="0">
  <tr class="hdr"><td>Member No</td><td>Name</td></tr>
<% for (const member of results) { %>
  <tr><td><a href="/member/<%= member.id %>"><%= member.id %></a></td><td><%= member.name %></td></tr>
<% } %>
</table>
<% } %>
</body>
</html>
