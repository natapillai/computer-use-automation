<html>
<head>
<title>MERIDIAN Core Sign In</title>
<style>
body { font-family: Tahoma, Verdana, sans-serif; font-size: 11px; background: #ece9d8; margin: 24px; }
h1 { font-size: 14px; margin: 0 0 8px 0; }
td.lbl { text-align: right; padding-right: 6px; }
p.err { color: #800000; font-weight: bold; }
</style>
</head>
<body>
<h1>MERIDIAN Core</h1>
<form method="post" action="/auth/login">
<table border="0" cellpadding="3" cellspacing="0">
  <tr><td class="lbl"><label for="username">User name:</label></td><td><input type="text" id="username" name="username" size="20"></td></tr>
  <tr><td class="lbl"><label for="password">Password:</label></td><td><input type="password" id="password" name="password" size="20"></td></tr>
  <tr><td></td><td><input type="submit" value="Sign In"></td></tr>
</table>
</form>
<% if (error !== null) { %>
<p class="err"><%= error %></p>
<% } %>
</body>
</html>
