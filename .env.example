# Copy to .env and adjust. Every value here is synthetic. No real credential belongs in this file.

# The local MERIDIAN Core fixture. These are the fixture's own login, defined in its seed data.
TARGET_BASE_URL=http://localhost:4010
TARGET_USERNAME=operator
TARGET_PASSWORD=meridian-fixture

# How long an escalated run waits for an operator to claim it before ending as unclaimed.
INTERVENTION_CLAIM_TIMEOUT_MS=300000

# Discovery only. The model id is configuration, per ADR 0011.
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY is read by the Anthropic SDK directly and is never parsed into this project's config.
