# Every key the system reads, with no values. Copy this file to .env and fill in every key.
# README.md documents each key and the value to use, including the current default model.

# The local MERIDIAN Core fixture, and the login the session broker signs in with.
TARGET_BASE_URL=
TARGET_USERNAME=
TARGET_PASSWORD=

# How long an escalated run waits for an operator to claim it, in milliseconds.
INTERVENTION_CLAIM_TIMEOUT_MS=

# Discovery only. The model id is configuration, per ADR 0011.
ANTHROPIC_MODEL=

# Discovery only. Read by the Anthropic SDK directly and never parsed into this project's config.
ANTHROPIC_API_KEY=
