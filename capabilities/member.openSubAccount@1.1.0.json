      "type": "string",
      "required": true,
      "description": "Institution member number",
      "sensitivity": "pii",
      "constraints": {
        "pattern": "^[0-9]{5,10}$"
      }
    },
    {
      "name": "accountType",
      "type": "enum",
      "enumValues": [
        "Savings",
        "Holiday Club",
        "Christmas Club"
      ],
      "required": true,
      "description": "The kind of sub account to open",
      "sensitivity": "internal"
    },
    {
      "name": "openingAmount",
      "type": "string",
      "required": true,
      "description": "The opening deposit, at least $25.00",
      "sensitivity": "pii",
      "constraints": {
        "pattern": "^[0-9]+\\.[0-9]{2}$"
      }
    }
  ],
  "outputs": [
